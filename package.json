{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-db": "bunx drizzle-kit generate --config drizzle.media.config.ts && bunx drizzle-kit generate --config drizzle.users.config.ts",
    "generate-routes": "tsr generate",
    "generate-css": "bunx tailwindcss -i ./src/index.css -o ./dist/output.css",
    "prebuild": "bun run generate-routes && bun run generate-css",
    "watch-routes": "tsr watch",
    "watch-css": "bunx tailwindcss -i ./src/index.css -o ./dist/output.css --watch",
    "dev": "concurrently \"bun run watch-routes\" \"bun run watch-css\" \"bun --hot src/server.ts\"",
    "build:windows": "bun build --compile --define LFMPLAYR_VERSION=\"v1.0.0\" --target=bun-windows-x64 --minify --sourcemap --bytecode ./src/server.ts --outfile lfmplayr",
    "start": "NODE_ENV=production bun src/server.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-router-devtools": "^1.167.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/router-cli": "^1.167.25",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^1.0.0-rc.4",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.3"
  }
}
